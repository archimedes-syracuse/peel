#!/bin/sh
# labwc starts this file asynchronously with sh; keep long-running daemons in
# the background so the rest of the session starts too.

"$HOME/.local/bin/wallpaper-restore" >/dev/null 2>&1 &
qs -n -c niri >/dev/null 2>&1 &
/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 >/dev/null 2>&1 &
swayidle -w \
    timeout 120 'swaylock -f' \
    before-sleep 'swaylock -f' >/dev/null 2>&1 &
